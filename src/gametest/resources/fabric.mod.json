{
  "schemaVersion": 1,
  "id": "sparkdlc_gametest",
  "version": "1.0.0",
  "name": "SparkDLC game tests",
  "description": "Headless boot and mixin-audit tests for SparkDLC. Never shipped: this source set is not part of the mod jar.",
  "environment": "*",
  "entrypoints": {
    "fabric-gametest": [
      "dev.caecorthus.sparkdlc.gametest.SparkDlcBootTest",
      "dev.caecorthus.sparkdlc.gametest.LegacyRegistryAliasesGameTest",
      "dev.caecorthus.sparkdlc.gametest.LegacySavedDataGameTest",
      "dev.caecorthus.sparkdlc.gametest.SparkDlcCommandTest",
      "dev.caecorthus.sparkdlc.gametest.SparkDlcStartupTest",
      "dev.caecorthus.sparkdlc.gametest.SparkDlcHandshakeGameTest"
    ],
    "client": [
      "dev.caecorthus.sparkdlc.gametest.SparkDlcClientAudit"
    ],
    "preLaunch": [
      "dev.caecorthus.sparkdlc.gametest.LegacyClientNamesFixture"
    ]
  },
  "depends": {
    "sparkdlc": "*",
    "fabric-gametest-api-v1": "*"
  }
}
