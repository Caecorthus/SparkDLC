{
  "schemaVersion": 1,
  "id": "sparkdlc",
  "version": "${version}",
  "name": "SparkDLC",
  "description": "Spark Wathe DLC: new roles and factions, reworked roles, traits, items and sabotage for Wathe, with an in-game guidebook, achievements and settings. DLC textures made by Claude, GPT-Image & I_siya.",
  "authors": [
    "Caecorthus"
  ],
  "license": [
    "AGPL-3.0-only",
    "LicenseRef-Textures-ARR"
  ],
  "environment": "*",
  "provides": [
    "sparkfactionapi",
    "sparkstrength",
    "sparktraits",
    "sparkwitch",
    "sparkassist"
  ],
  "entrypoints": {
    "main": [
      "dev.caecorthus.sparkdlc.SparkDLC"
    ],
    "client": [
      "dev.caecorthus.sparkdlc.client.SparkDLCClient"
    ],
    "cardinal-components": [
      "dev.caecorthus.sparkdlc.SparkDlcComponents"
    ],
    "voicechat": [
      "dev.caecorthus.sparkdlc.voice.SparkDlcVoiceChatPlugin"
    ],
